# Hostinger environment template. Copy existing secret values into the hosting
# panel, never into this file or Git. The server reads environment variables;
# it does not automatically load this example file.
KOINOS_NETWORK=mainnet
PUBLIC_URL=https://koinvault.app
PASSKEY_RPID=koinvault.app
DEMO_MODE=0
# Dedicated persistent directory. Accounts can be rediscovered from the chain.
# Do not share or copy an active funding ledger from the old wallet.
DATA_DIR=../koin-vault-data
# Keep the existing values; do not generate new keys or deploy new contracts.
SPONSOR_WIF=
VERIFIER_ADDR=
MOD_SIGN_WEBAUTHN_ADDR=
MOD_VALIDATION_SIGNATURE_ADDR=
# Copy the remaining funding, RPC, Android signing, and other environment
# variables from the existing wallet as well. Hostinger supplies PORT.
DAPP_ORIGINS=https://trade.koinoskit.site,https://app.tradekoinos.com,https://ouro.lifestyle,https://www.ouro.lifestyle,https://koinosai.com,https://usekoinos.com,https://www.usekoinos.com

# Independent backend; no requests to the old wallet.
WALLET_BACKEND_URL=local
